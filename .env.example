# Copy to .env and adjust for local development.
# Docker compose reads this file; native runs read it too.

# Browser -> backend URL (baked into Next.js at build time for prod)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend CORS allow-list (comma-separated)
CORS_ORIGINS=http://localhost:3000

# --- Doc2Data extraction -------------------------------------------------
# mock       = deterministic sample parser (works offline, no key)
# openrouter = hosted API for frontier models (https://openrouter.ai)
# ollama     = local model through Ollama's OpenAI-compatible endpoint
LLM_PROVIDER=mock

# OpenRouter: any model slug from https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Recommended local demo model: ollama pull gemma3:1b
OLLAMA_MODEL=gemma3:1b
# Optional. The app uses localhost natively and host.docker.internal in Docker;
# set this only to point at another host.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Linux: if Ollama binds to 127.0.0.1 only, expose it to Docker with
# OLLAMA_HOST=0.0.0.0:11434 in the Ollama service.

MAX_UPLOAD_MB=20
MAX_CHARS_PER_CHUNK=12000
# Long documents extract this many chunks at once. Lower it for one local model.
MAX_CHUNK_WORKERS=4

# Optional. Unset: Docker writes /app/data/doc2data.db, native writes backend/data/doc2data.db.
# DATABASE_PATH=backend/data/doc2data.db
