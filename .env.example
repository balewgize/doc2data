# Copy to .env and adjust for local development.
# Used by docker compose (dev + prod) and as a reference for native runs.

# Browser -> backend URL (baked into Next.js at build time for prod)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend CORS allow-list (comma-separated)
CORS_ORIGINS=http://localhost:3000

# --- Paperlane extraction -------------------------------------------------
# mock   = deterministic sample parser (works offline, no key)
# openai = OpenAI chat completions
# ollama = local model through Ollama's OpenAI-compatible endpoint
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Native runs use localhost. Docker runs need host.docker.internal instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

MAX_UPLOAD_MB=20
MAX_CHARS_PER_CHUNK=12000

# Optional for native runs; compose sets /app/data itself.
# DATABASE_PATH=backend/data/paperlane.db

# --- Supabase (optional in this MVP) ---------------------------------------
# The starter's shared Supabase client is kept for production storage/auth.
# Leave these empty for the local SQLite MVP. Never expose the service-role
# key to the frontend; it bypasses RLS.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
